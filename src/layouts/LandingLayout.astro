---
import logo from "../assets/logo.svg";
import avatar from "../assets/avatar.jpg";
import "../styles/fonts.css";
const { title, lang = "en", description = "Ruby on Rails freelancer since 2013. Available for product teams and non-technical founders." } = Astro.props;
const SITE_NAME = "Marcin Syngajewski";
const siteUrl ="https://syngajewski.com";
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(avatar.src, siteUrl).href;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      window.addEventListener("load", () => {
        const loadAnalytics = () => {
          const script = document.createElement("script");
          script.src = "https://scripts.simpleanalyticscdn.com/latest.js";
          script.async = true;
          script.dataset.skipDnt = "true";
          document.head.append(script);
        };

        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(loadAnalytics);
        } else {
          window.setTimeout(loadAnalytics, 1500);
        }
      });
    </script>
    <noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif" alt="" referrerpolicy="no-referrer-when-downgrade" /></noscript>
    <style is:global>
      :root {
        --bg:          #faf8f5;
        --bg-card:     #f4ede3;
        --sand-light:  #ecdfc9;
        --sand-mid:    #d6bc9c;
        --sand-dark:   #b8935a;
        --accent:      #9c6b38;
        --accent-dark: #7a5129;
        --text:        #1c1a17;
        --muted:       #7a7570;
        --rule:        #d6c9b8;
      }

      *, *::before, *::after { box-sizing: border-box; }

      html { font-size: 18px; scroll-behavior: smooth; }

      body {
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--text);
        background: var(--bg);
        margin: 0;
        padding: 0;
        line-height: 1.75;
      }

      /* ── Layout helpers ─────────────────────────── */
      .prose {
        max-width: 62ch;
        margin-inline: auto;
        padding-inline: 1.5rem;
      }

      .wide {
        max-width: 92ch;
        margin-inline: auto;
        padding-inline: 1.5rem;
      }

      /* ── Header ─────────────────────────────────── */
      header {
        max-width: 92ch;
        margin-inline: auto;
        padding: 1.75rem 1.5rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--text);
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        font-weight: bold;
      }

      .brand img { width: 24px; height: 24px; }

      .lang-switch {
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        font-size: 0.75rem;
        color: var(--muted);
        letter-spacing: 0.05em;
      }

      .lang-switch a { color: var(--text); text-decoration: none; }
      .lang-switch a:hover { text-decoration: underline; }
      .lang-switch span { color: var(--accent); }

      /* ── Typography ─────────────────────────────── */
      h1 {
        font-family: "Playfair Display", Georgia, "Times New Roman", serif;
        font-size: clamp(2.2rem, 5vw, 3.2rem);
        font-weight: 700;
        line-height: 1.12;
        letter-spacing: -0.01em;
        margin: 0 0 1.1rem;
        color: var(--text);
      }

      h2 {
        font-family: "Playfair Display", Georgia, "Times New Roman", serif;
        font-size: clamp(1.3rem, 3vw, 1.6rem);
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -0.01em;
        margin: 0 0 0.4rem;
      }

      h3 {
        font-size: 1rem;
        line-height: 1.3;
      }

      a { color: var(--text); }

      /* ── Section label (eyebrow text) ───────────── */
      .section-label {
        display: block;
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 1rem;
        margin-top: 0.25rem;
      }

      /* hero label still sits above h1 */
      .hero-content .section-label {
        margin-bottom: 0.75rem;
        margin-top: 0;
      }

      /* ── Divider ────────────────────────────────── */
      .divider {
        border: none;
        border-top: 1px solid var(--rule);
        margin: 0;
      }

      /* ── Landing sections ───────────────────────── */
      .landing-section {
        padding-block: 4rem;
      }

      /* ── Hero ───────────────────────────────────── */
      .hero-wrap {
        position: relative;
        overflow: hidden;
      }

      .blob {
        position: absolute;
        border-radius: 60% 40% 55% 45% / 58% 42% 58% 42%;
        pointer-events: none;
        z-index: 0;
      }

      .blob-1 {
        width: clamp(220px, 35vw, 380px);
        height: clamp(220px, 35vw, 380px);
        background: var(--sand-light);
        top: -80px;
        right: -80px;
        opacity: 0.55;
        border-radius: 62% 38% 50% 50% / 42% 58% 42% 58%;
      }

      .blob-2 {
        width: clamp(120px, 18vw, 200px);
        height: clamp(120px, 18vw, 200px);
        background: var(--sand-mid);
        bottom: 20px;
        right: clamp(100px, 20vw, 260px);
        opacity: 0.35;
        border-radius: 40% 60% 44% 56% / 60% 40% 60% 40%;
      }

      .blob-3 {
        width: clamp(80px, 12vw, 130px);
        height: clamp(80px, 12vw, 130px);
        background: var(--sand-dark);
        top: 30px;
        right: clamp(60px, 15vw, 180px);
        opacity: 0.2;
        border-radius: 50% 50% 40% 60% / 40% 60% 40% 60%;
      }

      .hero-content {
        position: relative;
        z-index: 1;
      }

      /* ── Services grid ──────────────────────────── */
      .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
      }

      /* ── CTA button ─────────────────────────────── */
      .cta-primary {
        display: inline-block;
        background: var(--accent);
        color: #fff;
        padding: 0.55em 1.3em;
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        font-size: 0.85rem;
        letter-spacing: 0.05em;
        text-decoration: none;
        border-radius: 3px;
        transition: background 0.15s;
        margin-top: 0.5rem;
      }

      .cta-primary:hover {
        background: var(--accent-dark);
        color: #fff;
      }

      /* ── Social links ───────────────────────────── */
      .social-links {
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        font-size: 0.82rem;
        color: var(--muted);
        margin-top: 1.5rem;
      }

      .social-links a {
        color: var(--text);
        text-decoration: none;
      }

      .social-links a:hover { text-decoration: underline; }

      /* ── Contact section ────────────────────────── */
      .contact-section {
        background: var(--bg-card);
        border-radius: 6px;
        padding: 3rem 1.5rem;
        text-align: center;
      }

      .contact-section h2 {
        margin-bottom: 0.5rem;
      }

      .contact-section p {
        color: var(--muted);
        margin: 0 auto 1.5rem;
        max-width: 45ch;
      }

      /* ── Footer ─────────────────────────────────── */
      footer {
        padding: 1.5rem 1.5rem 3rem;
        font-size: 0.75rem;
        color: var(--muted);
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        text-align: center;
      }

      /* ── Responsive ─────────────────────────────── */
      @media (max-width: 600px) {
        .landing-section { padding-block: 2.5rem; }
        .contact-section { padding: 2rem 1rem; }
        .blob-2, .blob-3 { display: none; }
      }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href={lang === "en" ? "/en/" : lang === "bg" ? "/bg/" : "/"}>
        <img src={logo.src} alt="" width="24" height="24" />
        Marcin Syngajewski
      </a>
      <div class="lang-switch">
        {lang === "pl" ? <span>pl</span> : <a href="/">pl</a>}
        {" · "}
        {lang === "en" ? <span>en</span> : <a href="/en/">en</a>}
        {" · "}
        {lang === "bg" ? <span>bg</span> : <a href="/bg/">bg</a>}
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>&copy; {new Date().getFullYear()} Marcin Syngajewski</footer>
  </body>
</html>
