---
import logo from "../assets/logo.svg";
import "../styles/fonts.css";
const { title, lang = "pl", description = "Ruby on Rails freelancer od 2013. Tworzę aplikacje webowe, produkty SaaS i strony osobiste." } = Astro.props;
const SITE_NAME = "Marcin Syngajewski";
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <script is:inline>
      window.addEventListener("load", () => {
        const loadAnalytics = () => {
          const script = document.createElement("script");
          script.src = "https://scripts.simpleanalyticscdn.com/latest.js";
          script.async = true;
          script.dataset.skipDnt = "true";
          document.head.append(script);
        };

        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(loadAnalytics);
        } else {
          window.setTimeout(loadAnalytics, 1500);
        }
      });
    </script>
    <noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif" alt="" referrerpolicy="no-referrer-when-downgrade" /></noscript>
    <style>
      :root {
        --bg:          #faf8f5;
        --bg-card:     #f4ede3;
        --sand-light:  #ecdfc9;
        --sand-mid:    #d6bc9c;
        --sand-dark:   #b8935a;
        --accent:      #9c6b38;
        --accent-dark: #7a5129;
        --text:        #1c1a17;
        --muted:       #7a7570;
        --rule:        #d6c9b8;
      }

      *, *::before, *::after { box-sizing: border-box; }

      html { font-size: 18px; scroll-behavior: smooth; }

      body {
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: var(--text);
        background: var(--bg);
        margin: 0;
        padding: 2rem 1rem 5rem;
        max-width: 68ch;
        margin-inline: auto;
        line-height: 1.75;
      }

      header {
        padding-bottom: 0.5rem;
        margin-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--text);
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        font-size: 0.82rem;
        letter-spacing: 0.06em;
        font-weight: 500;
      }

      .brand img { width: 24px; height: 24px; }

      .lang-switch {
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        font-size: 0.72rem;
        color: var(--muted);
        letter-spacing: 0.05em;
      }

      .lang-switch a { color: var(--text); text-decoration: none; }
      .lang-switch a:hover { text-decoration: underline; }
      .lang-switch span { color: var(--accent); }

      h1 {
        font-family: "Playfair Display", Georgia, "Times New Roman", serif;
        font-size: clamp(1.8rem, 4vw, 2.4rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
        color: var(--text);
      }

      h2 {
        font-family: "Playfair Display", Georgia, "Times New Roman", serif;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.25;
        margin: 2rem 0 0.5rem;
        color: var(--text);
      }

      h3 {
        font-size: 1.05rem;
        margin: 1.5rem 0 0.4rem;
      }

      a { color: var(--text); }

      p { margin: 0 0 1rem; }

      hr {
        border: none;
        border-top: 1px solid var(--rule);
        margin: 2rem 0;
      }

      code {
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        font-size: 0.85em;
        background: var(--bg-card);
        padding: 0.1em 0.35em;
        border-radius: 3px;
      }

      pre {
        background: var(--bg-card);
        border-left: 3px solid var(--sand-dark);
        padding: 1.2rem 1rem;
        overflow-x: auto;
        font-size: 0.82rem;
        border-radius: 0 4px 4px 0;
        margin: 1.5rem 0;
      }

      pre code {
        background: none;
        padding: 0;
        font-size: inherit;
      }

      footer {
        margin-top: 3rem;
        padding-top: 1rem;
        font-size: 0.72rem;
        color: var(--muted);
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        border-top: 1px solid var(--rule);
      }

      /* ── Article-specific styles ─────────────── */
      article h1 { margin-bottom: 0.25rem; }

      .post-meta {
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        font-size: 0.75rem;
        color: var(--muted);
        margin-bottom: 1.5rem;
        letter-spacing: 0.04em;
      }

      .post-description {
        color: var(--muted);
        font-style: italic;
        border-left: 3px solid var(--sand-dark);
        padding-left: 1rem;
        margin-bottom: 1.5rem;
      }

      .back-link {
        display: inline-block;
        font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
        font-size: 0.78rem;
        color: var(--accent);
        text-decoration: none;
        letter-spacing: 0.04em;
        margin-top: 2.5rem;
      }

      .back-link:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href={lang === "en" ? "/en/" : lang === "bg" ? "/bg/" : "/"}>
        <img src={logo.src} alt="" width="24" height="24" />
        Marcin Syngajewski
      </a>
      <div class="lang-switch">
        {lang === "pl" ? <span>pl</span> : <a href="/">pl</a>}
        {" · "}
        {lang === "en" ? <span>en</span> : <a href="/en/">en</a>}
        {" · "}
        {lang === "bg" ? <span>bg</span> : <a href="/bg/">bg</a>}
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>&copy; {new Date().getFullYear()} Marcin Syngajewski</footer>
  </body>
</html>
