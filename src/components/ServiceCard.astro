---
interface Props {
  title: string;
  body: string;
}
const { title, body } = Astro.props;
---

<div class="service">
  <h3>{title}</h3>
  <p>{body}</p>
</div>

<style>
  .service {
    background: #f4ede3;
    border-radius: 4px;
    padding: 1.4rem 1.25rem;
    border-left: 3px solid #b8935a;
  }

  .service h3 {
    margin: 0 0 0.6rem;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.9rem;
    font-weight: bold;
    letter-spacing: 0.03em;
    color: #1c1a17;
  }

  .service p {
    margin: 0;
    font-size: 0.92rem;
    color: #7a7570;
    line-height: 1.65;
  }
</style>
