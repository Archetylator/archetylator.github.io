---
import { Image } from "astro:assets";
import ServiceCard from "./ServiceCard.astro";
import WritingList from "./WritingList.astro";
import ProjectCard from "./ProjectCard.astro";
import type { CollectionEntry } from "astro:content";
import avatar from "../assets/avatar.jpg";

interface ServiceEntry {
  title: string;
  body: string;
}

interface ProjectEntry {
  name: string;
  url: string;
  label: string;
  body: string;
}

interface Props {
  heroEyebrow: string;
  heroHeading: string;
  heroBody: string;
  heroCta: string;

  servicesHeading: string;
  servicesEyebrow: string;
  services: ServiceEntry[];

  techServicesHeading: string;
  techServicesEyebrow: string;
  techServices: ServiceEntry[];

  aboutEyebrow: string;
  aboutHeading: string;
  aboutParagraphs: string[];

  projectsHeading: string;
  projectsEyebrow: string;
  projects: ProjectEntry[];

  writingEyebrow: string;
  writingHeading: string;
  writingBody: string;
  posts: CollectionEntry<"blog">[];

  contactEyebrow: string;
  contactHeading: string;
  contactBody: string;
  contactEmail: string;
}

const {
  heroEyebrow, heroHeading, heroBody, heroCta,
  servicesHeading, servicesEyebrow, services,
  techServicesHeading, techServicesEyebrow, techServices,
  aboutEyebrow, aboutHeading, aboutParagraphs,
  projectsHeading, projectsEyebrow, projects,
  writingEyebrow, writingHeading, writingBody, posts,
  contactEyebrow, contactHeading, contactBody, contactEmail,
} = Astro.props;

const social = [
  { label: "GitHub", url: "https://github.com/Archetylator" },
  { label: "LinkedIn", url: "https://linkedin.com/in/marcin-syngajewski" },
]

const navItems = [
  { href: "#services", label: servicesEyebrow },
  { href: "#stack", label: techServicesHeading },
  { href: "#projects", label: projectsHeading },
  ...(posts.length > 0 ? [{ href: "#blog", label: writingEyebrow }] : []),
  { href: "#contact", label: contactEyebrow },
];
---

<nav class="section-nav" aria-label="Section navigation">
  {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
</nav>

<!-- ── Hero ─────────────────────────────────── -->
<div class="hero-wrap">
  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>
  <div class="blob blob-3"></div>
  <section class="prose landing-section hero-content">
    <span class="section-label">{heroEyebrow}</span>
    <h1>{heroHeading}</h1>
    <p>{heroBody}</p>
    <!--email_off-->
    <a class="cta-primary" href={`mailto:${contactEmail}`}>{heroCta}</a>
    <!--/email_off-->
  </section>
</div>

<hr class="divider" />

<!-- ── Services ──────────────────────────────── -->
<section id="services" class="wide landing-section">
  <h2>{servicesHeading}</h2>
  <span class="section-label">{servicesEyebrow}</span>
  <div class="services-grid">
    {services.map(s => <ServiceCard title={s.title} body={s.body} />)}
  </div>
</section>

<hr class="divider" />

<!-- ── Technical services ─────────────────────── -->
<section id="stack" class="wide landing-section">
  <h2>{techServicesHeading}</h2>
  <span class="section-label">{techServicesEyebrow}</span>
  <div class="services-grid">
    {techServices.map(s => <ServiceCard title={s.title} body={s.body} />)}
  </div>
</section>

<hr class="divider" />

<!-- ── About ──────────────────────────────────── -->
<section class="prose landing-section about-section">
  <div class="about-avatar">
    <Image src={avatar} alt="Marcin Syngajewski" width={120} height={120} class="avatar-img" />
  </div>
  <div class="about-text">
    <span class="section-label">{aboutEyebrow}</span>
    <h2>{aboutHeading}</h2>
    {aboutParagraphs.map(p => <p>{p}</p>)}
    <p class="social-links">
      {social.map((link, i) => (
        <>
          {i > 0 && <>&nbsp;·&nbsp;</>}
          <a href={link.url}>{link.label}</a>
        </>
      ))}
    </p>
  </div>
</section>

<hr class="divider" />

<!-- ── Projects ──────────────────────────────── -->
<section id="projects" class="prose landing-section">
  <h2>{projectsHeading}</h2>
  <span class="section-label">{projectsEyebrow}</span>
  {projects.map(p => (
    <ProjectCard name={p.name} url={p.url} label={p.label} body={p.body} />
  ))}
</section>

<hr class="divider" />

{posts.length > 0 && (
  <section id="blog" class="prose landing-section">
    <span class="section-label">{writingEyebrow}</span>
    <h2>{writingHeading}</h2>
    <p>{writingBody}</p>
    <WritingList posts={posts} />
  </section>

  <hr class="divider" />
)}

<!-- ── Contact CTA ───────────────────────────── -->
<section id="contact" class="wide landing-section">
  <div class="contact-section">
    <span class="section-label">{contactEyebrow}</span>
    <h2>{contactHeading}</h2>
    <p>{contactBody}</p>
    <!--email_off-->
    <p class="contact-email">
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    </p>
    <a class="cta-primary" href={`mailto:${contactEmail}`}>{contactEmail} →</a>
    <!--/email_off-->
  </div>
</section>

<style>
  .section-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    overflow-x: auto;
    padding: 0.55rem 1rem;
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    border-block: 1px solid var(--rule);
    backdrop-filter: blur(12px);
  }
  .section-nav a {
    flex: 0 0 auto;
    padding: 0.25rem 0.55rem;
    color: var(--muted);
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .section-nav a:hover,
  .section-nav a:focus-visible {
    color: var(--text);
    text-decoration: underline;
  }
  .landing-section {
    scroll-margin-top: 3.25rem;
  }
  .about-section {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }
  .about-avatar {
    flex-shrink: 0;
  }
  .avatar-img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
  }
  .contact-email {
    margin-bottom: 0.75rem;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  @media (max-width: 480px) {
    .about-section {
      flex-direction: column;
    }
    .section-nav {
      justify-content: flex-start;
    }
  }
</style>
