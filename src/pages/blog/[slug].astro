---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const lang = post.data.lang ?? "pl";
const backHref = lang === "en" ? "/en/" : lang === "bg" ? "/bg/" : "/";
const backLabel = lang === "en" ? "← back" : lang === "bg" ? "← назад" : "← powrót";
---

<BaseLayout title={post.data.title} lang={lang}>
  <article>
    <h1>{post.data.title}</h1>
    <p class="post-meta">
      <time datetime={post.data.date.toISOString().slice(0, 10)}>
        {post.data.date.toISOString().slice(0, 10)}
      </time>
    </p>
    {post.data.description && (
      <p class="post-description">{post.data.description}</p>
    )}
    <hr />
    <Content />
  </article>
  <a class="back-link" href={backHref}>{backLabel}</a>
</BaseLayout>
