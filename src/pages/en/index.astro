---
import LandingLayout from "../../layouts/LandingLayout.astro";
import LandingPage from "../../components/LandingPage.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => p.data.lang === "en")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<LandingLayout
  lang="en"
  title="Rails Developer for Hire"
  description="Ruby on Rails freelancer since 2013. I build web applications, SaaS products, and personal sites for product teams and non-technical founders."
>
  <LandingPage
    heroEyebrow="Available for hire"
    heroHeading="Building web things since 2013."
    heroBody="Ruby on Rails developer. I build web applications, SaaS products, and personal sites — for dev teams and entrepreneurs alike."
    heroCta="Get in touch →"
    servicesHeading="What I can help with"
    servicesEyebrow="Services"
    services={[
      { title: "Personal sites", body: "A clean, fast site for your practice, studio, or small business. You describe what you need, I take care of the rest." },
      { title: "SaaS products", body: "Full product builds for entrepreneurs with an idea but no dev team. From concept to launched product, with a maintainable codebase." },
      { title: "Mobile apps", body: "Cross-platform mobile apps for iOS and Android. Built to integrate cleanly with your backend." },
    ]}
    techServicesHeading="Tech stack"
    techServicesEyebrow="For recruiters & dev teams"
    techServices={[
      { title: "Ruby & Ruby on Rails", body: "Backend Rails work since 2013 — greenfield, legacy, API-only. Testing (RSpec, Minitest), deployment, query optimisation." },
      { title: "Frontend — HTML, CSS, JS", body: "SvelteKit and React on the client side; Stimulus and Turbo alongside Rails. Semantic HTML, modern CSS, accessibility." },
      { title: "AI & agentic engineering", body: "Designing and shipping AI-driven solutions — agents, RAG pipelines, LLM API integrations (OpenAI, Anthropic)." },
    ]}
    aboutEyebrow="About"
    aboutHeading="A bit about me"
    aboutParagraphs={[
      "I've been writing Rails professionally since 2013. Most of my work is for startups and small product teams — the kind of projects where I'm the only backend developer or one of two. I also work with business owners who have an idea but no dev team, handling everything from concept to deployment.",
      "Based in Bulgaria, fluent in English and Bulgarian, comfortable with async communication across time zones.",
    ]}
    projectsHeading="Projects"
    projectsEyebrow="What I build"
    projects={[
      { name: "WhenSpace", url: "https://whenspace.app/", label: "Side project", body: "A productivity app that brings tasks, calendar, and habit tracking into one clean interface. Offline-first, private by design — no accounts, no cloud sync required." },
    ]}
    writingEyebrow="Writing"
    writingHeading="Notes on backend & infrastructure"
    writingBody="I occasionally write about the things I run into — Rails, DevOps, VPS costs, deployment workflows."
    posts={posts}
    contactEyebrow="Contact"
    contactHeading="Let's work together"
    contactBody="Available for new projects. Not sure if I'm the right fit? Send me a message anyway — I'll tell you honestly."
    contactEmail="marcin@syngajewski.com"
  />
</LandingLayout>
