---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => p.data.lang === "en")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout lang="en">
  <h1>Marcin Syngajewski</h1>
  <p>
    I'm a web developer working with Ruby on Rails since 2013. I also write a
    fair amount of the Internet's lingua franca, almighty JavaScript.
  </p>
  <p>
    <a href="https://github.com/Archetylator">GitHub</a>,
    <a href="https://stackoverflow.com/users/3459543/archetylator"
      >Stack Overflow</a
    >,
    <a href="https://linkedin.com/in/marcin-syngajewski">LinkedIn</a>,
    <a href="https://www.upwork.com/freelancers/~018a75323f90fef96f">Upwork</a>.
  </p>

  <hr />

  <section>
    {posts.length === 0 && <p>No posts yet.</p>}
    <ul style="padding-left: 1.2rem;">
      {
        posts.map((post) => (
          <li style="margin-bottom: 0.4rem;">
            <a href={`/blog/${post.id}`}>{post.data.title}</a>{" "}
            <span style="color: #888; font-size: 0.85rem; font-family: 'Courier New', monospace;">
              {post.data.date.toISOString().slice(0, 10)}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
