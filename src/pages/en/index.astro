---
import LandingLayout from "../../layouts/LandingLayout.astro";
import LandingPage from "../../components/LandingPage.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => p.data.lang === "en")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<LandingLayout
  lang="en"
  title="Developer"
  description="I build websites, web apps, and SaaS products."
>
  <LandingPage
    heroEyebrow="Got an idea? I'd love to help!"
    heroHeading="I turn ideas into working solutions."
    heroBody="I build websites, web applications, and SaaS products."
    heroCta="Write to me →"
    servicesHeading="How I can help"
    servicesEyebrow="Services"
    services={[
      { title: "Websites", body: "A modern site for your practice, studio, or project. You tell me what you need — I handle the rest." },
      { title: "Web applications", body: "I help entrepreneurs without a technical team turn ideas into working products." },
      { title: "Mobile apps", body: "Cross-platform apps for iOS and Android. Performance, consistent UI/UX, and easy product growth." },
    ]}
    techServicesHeading="Tech stack"
    techServicesEyebrow="For recruiters and teams"
    techServices={[
      { title: "Ruby & Ruby on Rails", body: "Writing Rails since 2013. Experience with Hotwire, Turbo, Stimulus, ActiveAdmin, Devise, Pundit, Rolify, Slim, Twilio, Stripe, Rubocop, RSpec, Minitest." },
      { title: "HTML, CSS, JS", body: "I use SvelteKit, React, and Node.js. I apply Tailwind CSS and Drizzle ORM, keep code quality with ESLint and Prettier, and write tests with Vitest and Playwright." },
      { title: "AI & agentic engineering", body: "I build AI solutions — chatbots, agents (including voice and telephony), and RAG systems. I integrate LLMs (OpenAI, Anthropic) into applications via LangChain." },
    ]}
    aboutEyebrow="About"
    aboutHeading="A bit about me"
    aboutParagraphs={[
      "I'm from Poland, and I've been living in Bulgaria for many years. I'm an outdoor person — I love hiking, especially in the mountains.",
    ]}
    projectsHeading="Projects"
    projectsEyebrow="What I'm building"
    projects={[
      { name: "WhenSpace", url: "https://whenspace.app/", label: "Personal project", body: "A mobile app that brings order to your day — combining tasks, calendar, and habits in one place. No unnecessary clutter, with a focus on simplicity and clarity." },
    ]}
    writingEyebrow="Blog"
    writingHeading="Posts"
    writingBody="A bit about this, a bit about that."
    posts={posts}
    contactEyebrow="Contact"
    contactHeading="Let's collaborate"
    contactBody="I'm open to new projects. Not sure if I'm the right fit? Write anyway — I'll be honest."
    contactEmail="marcin@syngajewski.com"
  />
</LandingLayout>
