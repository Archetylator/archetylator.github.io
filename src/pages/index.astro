---
import LandingLayout from "../layouts/LandingLayout.astro";
import LandingPage from "../components/LandingPage.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => p.data.lang === "pl")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<LandingLayout
  lang="pl"
  title="Programista"
  description="Tworzę strony internetowe, aplikacje webowe i produkty SaaS."
>
  <LandingPage
    heroEyebrow="Masz pomysł? Chętnie pomogę!"
    heroHeading="Zamieniam pomysły w działające rozwiązania."
    heroBody="Tworzę strony internetowe, aplikacje webowe i produkty SaaS."
    heroCta="Napisz do mnie →"
    servicesHeading="Jak mogę pomóc"
    servicesEyebrow="Usługi"
    services={[
      { title: "Strony internetowe", body: "Nowoczesna strona dla Twojej działalności — praktyki, studia lub projektu. Ty mówisz, czego potrzebujesz — ja robię resztę." },
      { title: "Aplikacje webowe", body: "Pomagam przedsiębiorcom bez zespołu technicznego zamieniać pomysły w działające produkty." },
      { title: "Aplikacje mobilne", body: "Tworzę wieloplatformowe aplikacje na iOS i Android. Wydajność, spójny UI/UX i łatwy rozwój produktu." },
    ]}
    techServicesHeading="Stack technologiczny"
    techServicesEyebrow="Dla rekruterów i zespołów"
    techServices={[
      { title: "Ruby & Ruby on Rails", body: "Programuję w Ruby on Rails od 2013 roku. Doświadczenie z Hotwire, Turbo, Stimulus, ActiveAdmin, Devise, Pundit, Rolify, Slim, Twilio, Stripe, Rubocop, RSpec, Minitest." },
      { title: "HTML, CSS, JS", body: "Wykorzystuję SvelteKit, React i Node.js. Stosuję Tailwind CSS i Drizzle ORM, dbam o jakość kodu przy użyciu ESLint i Prettier, a testy realizuję z użyciem Vitest i Playwright." },
      { title: "AI & agentic engineering", body: "Wdrażam rozwiązania AI — chatboty, agentów (także głosowych i telefonicznych) oraz systemy RAG. Integruję LLM (OpenAI, Anthropic) z aplikacjami (LangChain)." },
    ]}
    aboutEyebrow="O mnie"
    aboutHeading="Kilka słów o mnie"
    aboutParagraphs={[
      "Pochodzę z Polski, a od wielu lat mieszkam w Bułgarii. Jestem wiatroczłapem — lubię chodzić, najlepiej w stronę gór.",
    ]}
    projectsHeading="Projekty"
    projectsEyebrow="Co buduję"
    projects={[
      { name: "WhenSpace", url: "https://whenspace.app/", label: "Projekt autorski", body: "Aplikacja mobilna, która porządkuje Twój dzień — łączy zadania, kalendarz i nawyki w jednym miejscu. Bez zbędnego chaosu, z naciskiem na prostotę i klarowność." },
    ]}
    writingEyebrow="Blog"
    writingHeading="Posty"
    writingBody="Trochę o tym, trochę o tamtym."
    posts={posts}
    contactEyebrow="Kontakt"
    contactHeading="Współpracujmy"
    contactBody="Przyjmuję nowe projekty. Nie jesteś pewien czy pasuję? Napisz mimo to — odpowiem szczerze."
    contactEmail="marcin@syngajewski.com"
  />
</LandingLayout>
