---
import LandingLayout from "../layouts/LandingLayout.astro";
import LandingPage from "../components/LandingPage.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => p.data.lang === "pl")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<LandingLayout
  lang="pl"
  title="Programista do wynajęcia"
  description="Programista Ruby on Rails od 2013. Tworzę aplikacje webowe, produkty SaaS i strony osobiste dla zespołów i przedsiębiorców."
>
  <LandingPage
    heroEyebrow="Masz pomysł? Chętnie pomogę!"
    heroHeading="Buduję rzeczy w sieci od 2013."
    heroBody="Tworzę aplikacje webowe, produkty SaaS i strony osobiste — dla zespołów deweloperskich i przedsiębiorców."
    heroCta="Napisz do mnie →"
    servicesHeading="Jak mogę pomóc"
    servicesEyebrow="Usługi"
    services={[
      { title: "Strony osobiste", body: "Nowoczesna, szybka strona dla Twojej praktyki, studia lub małej firmy. Opisujesz czego potrzebujesz, resztą zajmuję się ja." },
      { title: "Produkty SaaS", body: "Kompleksowe budowanie produktów dla przedsiębiorców z pomysłem, ale bez zespołu deweloperskiego. Od koncepcji do działającego produktu." },
      { title: "Aplikacje mobilne", body: "Wieloplatformowe aplikacje mobilne na iOS i Android. Tani rozwój, szybkie aktualizacje i spójność UI/UX." },
      { title: "Rozwój aplikacji Rails", body: "Nowe projekty i długoterminowa praca produktowa. Przejmuję cały backend — od schematu bazy danych po deployment." },
      { title: "Ratowanie starego kodu", body: "Aktualizacja starych aplikacji Rails, porządkowanie długu technicznego, dodawanie testów tam, gdzie ich brakuje." },
      { title: "JavaScript", body: "Praca w JavaScript obok backendu Rails — Stimulus, Turbo lub vanilla JS. Bez zbędnych frameworków." },
    ]}
    aboutEyebrow="O mnie"
    aboutHeading="Kilka słów o mnie"
    aboutParagraphs={[
      "Piszę w Ruby on Rails zawodowo od 2013 roku. Pracuję przede wszystkimi z tymi, którzy mają pomysł, ale nie mają zespołu — przejmuję wszystko od koncepcji po wdrożenie.",
      "Urodziłem się w Polsce, ale żyję w Bułgarii. Mówię płynnie po polsku, angielsku i bułgarsku.",
    ]}
    projectsHeading="Projekty"
    projectsEyebrow="Co buduję"
    projects={[
      { name: "WhenSpace", url: "https://whenspace.app/", label: "Projekt własny", body: "Aplikacja łącząca zadania, kalendarz i śledzenie nawyków w jednym interfejsie. Offline-first. Zbudowana z użyciem Tauri, Rust i SvelteKit." },
    ]}
    writingEyebrow="Blog"
    writingHeading="Notatki"
    writingBody="Piszę o różnych rzeczach, o mydle i powidle."
    posts={posts}
    contactEyebrow="Kontakt"
    contactHeading="Współpracujmy"
    contactBody="Przyjmuję nowe projekty. Nie jesteś pewien czy pasuję? Napisz mimo to — odpowiem szczerze."
    contactEmail="marcin@syngajewski.com"
  />
</LandingLayout>
