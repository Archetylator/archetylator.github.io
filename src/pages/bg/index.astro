---
import LandingLayout from "../../layouts/LandingLayout.astro";
import LandingPage from "../../components/LandingPage.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => p.data.lang === "bg")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<LandingLayout
  lang="bg"
  title="Уеб разработчик под наем"
  description="Ruby on Rails разработчик от 2013. Изграждам уебсайтове, SaaS продукти и мобилни приложения за бизнеси и нетехнически клиенти."
>
  <LandingPage
    heroEyebrow="Приемам нови проекти"
    heroHeading="Изграждам уеб неща от 2013."
    heroBody="Ruby on Rails разработчик. Изграждам уеб приложения, SaaS продукти и лични сайтове — за dev екипи и предприемачи."
    heroCta="Свържете се →"
    servicesHeading="С какво мога да помогна"
    servicesEyebrow="Услуги"
    services={[
      { title: "Rails разработка", body: "Изграждане на нови проекти и поддръжка на съществуващи. Поемам целия backend — от базата данни до сървъра." },
      { title: "Спасяване на стар код", body: "Ъпгрейд на стари Rails приложения, разчистване на технически дълг, добавяне на тестове там, където ги няма." },
      { title: "JavaScript / frontend", body: "JavaScript работа заедно с Rails backend — Stimulus, Turbo или vanilla JS. Без излишни фреймъркове." },
      { title: "Лични сайтове", body: "Чист, бърз сайт за вашата практика, студио или малък бизнес. Вие описвате, аз изграждам." },
      { title: "SaaS продукти", body: "Пълно изграждане на продукти за предприемачи с идея, но без dev екип. От концепция до работещ продукт." },
      { title: "Мобилни приложения", body: "Кросплатформени мобилни приложения за iOS и Android. Интегрират се чисто с вашия backend." },
    ]}
    aboutEyebrow="За мен"
    aboutHeading="Малко повече"
    aboutParagraphs={[
      "Пиша Rails професионално от 2013 година. Работя основно за стартъпи и малки екипи — проекти, при които аз съм единственият или един от двама backend разработчици. Работя и с предприемачи, които имат идея, но нямат dev екип — поемам всичко от концепцията до пускането на продукта.",
      "Базиран съм в България, говоря свободно английски и български, удобен съм с асинхронна комуникация.",
    ]}
    projectsHeading="Проекти"
    projectsEyebrow="Какво изграждам"
    projects={[
      { name: "WhenSpace", url: "https://whenspace.app/", label: "Личен проект", body: "Приложение за продуктивност, което обединява задачи, календар и проследяване на навици в един интерфейс. Работи офлайн, без акаунт и без синхронизация с облак." },
    ]}
    writingEyebrow="Статии"
    writingHeading="Бележки за backend и инфраструктура"
    writingBody="Пиша за Rails, DevOps, сървъри и deployment."
    posts={posts}
    contactEyebrow="Контакт"
    contactHeading="Нека работим заедно"
    contactBody="Приемам нови проекти. Не сте сигурни дали съм правилният избор? Пишете ми — ще ви отговоря честно."
    contactEmail="marcin@syngajewski.com"
  />
</LandingLayout>
