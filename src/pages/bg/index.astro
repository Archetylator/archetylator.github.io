---
import LandingLayout from "../../layouts/LandingLayout.astro";
import LandingPage from "../../components/LandingPage.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => p.data.lang === "bg")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<LandingLayout
  lang="bg"
  title="Програмист"
  description="Изграждам уебсайтове, уеб приложения и SaaS продукти."
>
  <LandingPage
    heroEyebrow="Имаш идея? С удоволствие ще помогна!"
    heroHeading="Превръщам идеи в работещи решения."
    heroBody="Изграждам уебсайтове, уеб приложения и SaaS продукти."
    heroCta="Пиши ми →"
    servicesHeading="Как мога да помогна"
    servicesEyebrow="Услуги"
    services={[
      { title: "Уебсайтове", body: "Модерен сайт за твоята дейност — практика, студио или проект. Кажи ми какво ти трябва — аз се грижа за останалото." },
      { title: "Уеб приложения", body: "Помагам на предприемачи без технически екип да превърнат идеите си в работещи продукти." },
      { title: "Мобилни приложения", body: "Кросплатформени приложения за iOS и Android. Бързодействие, единен UI/UX и лесно развитие на продукта." },
    ]}
    techServicesHeading="Технологичен стек"
    techServicesEyebrow="За рекрутъри и екипи"
    techServices={[
      { title: "Ruby & Ruby on Rails", body: "Пиша на Ruby on Rails от 2013 година. Опит с Hotwire, Turbo, Stimulus, ActiveAdmin, Devise, Pundit, Rolify, Slim, Twilio, Stripe, Rubocop, RSpec, Minitest." },
      { title: "HTML, CSS, JS", body: "Използвам SvelteKit, React и Node.js. Прилагам Tailwind CSS и Drizzle ORM, поддържам качество на кода с ESLint и Prettier, а тестовете пиша с Vitest и Playwright." },
      { title: "AI & agentic engineering", body: "Внедрявам AI решения — чатботове, агенти (включително гласови и телефонни) и RAG системи. Интегрирам LLM модели (OpenAI, Anthropic) в приложения чрез LangChain." },
    ]}
    aboutEyebrow="За мен"
    aboutHeading="Няколко думи за мен"
    aboutParagraphs={[
      "Произхождам от Полша, а от много години живея в България. Обичам да ходя пеша — най-добре към планините.",
      "Книги, които са ми останали: „Човекът в търсене на смисъл”, „Седемте навика на високоефективните хора”, „Смелостта да бъдеш нехаресван” — и Библията.",
    ]}
    projectsHeading="Проекти"
    projectsEyebrow="Какво изграждам"
    projects={[
      { name: "WhenSpace", url: "https://whenspace.app/", label: "Личен проект", body: "Мобилно приложение, което организира деня ти — обединява задачи, календар и навици на едно място. Без излишен хаос, с акцент върху простота и яснота." },
    ]}
    writingEyebrow="Блог"
    writingHeading="Публикации"
    writingBody="Малко за едното, малко за другото."
    posts={posts}
    contactEyebrow="Контакт"
    contactHeading="Нека си сътрудничим"
    contactBody="Приемам нови проекти. Не си сигурен дали съм подходящ? Пиши ми въпреки това — ще отговоря честно."
    contactEmail="marcin@syngajewski.com"
  />
</LandingLayout>
